{
  "name": "vite-template-redux",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "preview": "vite preview",
